{
  "name": "openchamber-kanban",
  "version": "0.13.0",
  "private": true,
  "description": "Local-first Kanban board for OpenChamber that links tasks to real OpenCode sessions.",
  "license": "MIT",
  "author": "Libio Goncalves Braz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libgoncalv/openchamber-kanban.git"
  },
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "kanban-board",
        "name": "Kanban",
        "icon": "task",
        "entry": "panel/frame.html",
        "mobile": true
      },
      "page": {
        "entry": "panel/page.html",
        "title": "Kanban board",
        "mobile": true
      },
      "capabilities": [
        "sessions",
        "prompt",
        "microphone"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true,
        "permissions": {
          "exec": [
            "git"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@openchamber/sdk": "2.8.0",
    "sherpa-onnx-linux-x64": "2.0.1",
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
